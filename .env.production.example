POSTGRES_DB=looksgood
POSTGRES_USER=looksgood
POSTGRES_PASSWORD=change_me_to_a_long_random_password

DOMAIN=example.com
CERT_NAME=example.com

APP_ENV=production

JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Base URL used when generating local fallback media URLs (Cloudinary not configured).
# Example: https://www.example.com
PUBLIC_BASE_URL=https://www.example.com

# Comma-separated origins for your mobile/web apps.
# Example: https://looksbook.example.com,https://app.looksbook.example.com
CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOW_CREDENTIALS=false

# Stripe commerce
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Stripe subscriptions (AI features / ads removal)
# Create recurring prices in Stripe and paste the Price IDs here.
STRIPE_SUBSCRIPTION_PRICE_PRO=
STRIPE_SUBSCRIPTION_PRICE_CREATOR=
